+		case (state)
+			S_IDLE:
+				if (need0 || need1 || need2) begin
+					tag[sel_slot]   <= sel_blk;
+					valid[sel_slot] <= 1'b0;
+					cur_slot        <= sel_slot;
+
+					fill_slot <= sel_slot;
+					fill_off  <= sel_off;
+					fill_len  <= (data_size == 0 || sel_left >= 32'd4096) ? 16'd4096 : sel_left[15:0];
+					fill_tgl  <= ~fill_tgl;
+					state     <= S_WAIT;
 				end
 
-			1: if(DDRAM_DOUT_READY) begin
-					ram_q <= DDRAM_DOUT;
-					state <= 2;
+			S_WAIT:
+				if (fill_done_tgl != done_prev) begin
+					settle <= 0;
+					state  <= S_SETTLE;
 				end
 
-			2: if(DDRAM_DOUT_READY) begin
-					next_q <= DDRAM_DOUT;
-					state  <= 0;
-					rd_seek_done <= 1;
+			S_SETTLE:
+				begin
+					settle <= settle + 1'd1;
+					if (settle == 8'd255) begin
+						valid[cur_slot] <= 1'b1;
+						state           <= S_IDLE;
+					end
 				end
+
+			default: state <= S_IDLE;
 		endcase
 	end
