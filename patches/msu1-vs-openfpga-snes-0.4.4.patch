+			// ---- transfer completions ----
+			ST_A_FIN:
+				begin
+					diag_r   <= (res != 16'd0) ? 4'd4 : 4'd3;   // PCM data fetch result
+					a_err_r  <= (res != 16'd0);
+					a_done_r <= ~a_done_r;
+					state    <= ST_IDLE;
+				end
+			ST_D_FIN:
+				begin
+					d_err_r  <= (res != 16'd0);
+					d_done_r <= ~d_done_r;
+					state    <= ST_IDLE;
+				end
+
+			default: state <= ST_IDLE;
+		endcase
+	end
+end
