-	puts $outputFile "   0E0 : $buildDate4Byte;"
-	puts $outputFile "   0E1 : $buildTime4Byte;"
-	puts $outputFile "   0E2 : $buildUnique4Byte;"
-	puts $outputFile ""
-	puts $outputFile "END;"
